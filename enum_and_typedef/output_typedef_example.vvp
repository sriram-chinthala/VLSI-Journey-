#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x58c0c5c73f00 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x58c0c5c4e490 .scope module, "typedef_example" "typedef_example" 3 1;
 .timescale 0 0;
v0x58c0c5c4fd20_0 .var "a_byte", 7 0;
v0x58c0c5c50400_0 .var "b_byte", 7 0;
v0x58c0c5c96360_0 .var "c_byte", 7 0;
    .scope S_0x58c0c5c4e490;
T_0 ;
    %pushi/vec4 99, 0, 8;
    %store/vec4 v0x58c0c5c4fd20_0, 0, 8;
    %pushi/vec4 201, 0, 8;
    %store/vec4 v0x58c0c5c50400_0, 0, 8;
    %load/vec4 v0x58c0c5c4fd20_0;
    %load/vec4 v0x58c0c5c50400_0;
    %add;
    %store/vec4 v0x58c0c5c96360_0, 0, 8;
    %vpi_call/w 3 14 "$display", "the values that are added are %d | %d  result is %d", v0x58c0c5c4fd20_0, v0x58c0c5c50400_0, v0x58c0c5c96360_0 {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "typedef_example.sv";
