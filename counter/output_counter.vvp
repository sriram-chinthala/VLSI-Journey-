#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x655115fbe970 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x655115fbeb00 .scope module, "tb_counter_16" "tb_counter_16" 3 1;
 .timescale 0 0;
v0x655115fd30b0_0 .var "clk", 0 0;
v0x655115fd3180_0 .net "count", 3 0, v0x655115fd2eb0_0;  1 drivers
v0x655115fd3250_0 .var "rst_n", 0 0;
S_0x655115f84490 .scope module, "dut" "counter_16" 3 6, 4 1 0, S_0x655115fbeb00;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst_n";
    .port_info 2 /OUTPUT 4 "count";
v0x655115f846c0_0 .net "clk", 0 0, v0x655115fd30b0_0;  1 drivers
v0x655115fd2eb0_0 .var "count", 3 0;
v0x655115fd2f90_0 .net "rst_n", 0 0, v0x655115fd3250_0;  1 drivers
E_0x655115f84910 .event posedge, v0x655115f846c0_0;
    .scope S_0x655115f84490;
T_0 ;
    %wait E_0x655115f84910;
    %load/vec4 v0x655115fd2f90_0;
    %nor/r;
    %pad/u 32;
    %cmpi/e 1, 0, 32;
    %jmp/0xz  T_0.0, 4;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x655115fd2eb0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x655115fd2eb0_0;
    %cmpi/e 15, 0, 4;
    %jmp/0xz  T_0.2, 4;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x655115fd2eb0_0, 0;
    %jmp T_0.3;
T_0.2 ;
    %load/vec4 v0x655115fd2eb0_0;
    %addi 1, 0, 4;
    %assign/vec4 v0x655115fd2eb0_0, 0;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x655115fbeb00;
T_1 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x655115fd3250_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x655115fd30b0_0, 0, 1;
    %end;
    .thread T_1;
    .scope S_0x655115fbeb00;
T_2 ;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x655115fd3250_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x655115fd3250_0, 0, 1;
    %delay 100, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x655115fd3250_0, 0, 1;
    %delay 30, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x655115fd3250_0, 0, 1;
    %end;
    .thread T_2;
    .scope S_0x655115fbeb00;
T_3 ;
    %delay 5, 0;
    %load/vec4 v0x655115fd30b0_0;
    %inv;
    %store/vec4 v0x655115fd30b0_0, 0, 1;
    %jmp T_3;
    .thread T_3;
    .scope S_0x655115fbeb00;
T_4 ;
    %vpi_call/w 3 24 "$monitor", "%0t\011%b\011%0d", $time, v0x655115fd3250_0, v0x655115fd3180_0 {0 0 0};
    %delay 1000, 0;
    %vpi_call/w 3 25 "$finish" {0 0 0};
    %end;
    .thread T_4;
    .scope S_0x655115fbeb00;
T_5 ;
    %vpi_call/w 3 29 "$dumpfile", "counter_16.vcd" {0 0 0};
    %vpi_call/w 3 30 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x655115fbeb00 {0 0 0};
    %end;
    .thread T_5;
