:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x63fb2039d490 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x63fb2039d640 .scope module, "test_urandom_range" "test_urandom_range" 3 1;
 .timescale 0 0;
v0x63fb2039d7d0_0 .var/2s "random_val_signed", 31 0;
v0x63fb203ed400_0 .var "random_val_unsigned", 7 0;
    .scope S_0x63fb2039d640;
T_0 ;
    %vpi_call/w 3 7 "$display", "=== Test Case 1: (0, 100) ===" {0 0 0};
    %pushi/vec4 5, 0, 32;
T_0.0 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_0.1, 5;
    %jmp/1 T_0.1, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %vpi_func 3 9 "$urandom_range" 32, 32'sb00000000000000000000000000000000, 32'sb00000000000000000000000001100100 {0 0 0};
    %pad/u 8;
    %store/vec4 v0x63fb203ed400_0, 0, 8;
    %vpi_call/w 3 10 "$display", "Result: %0d", v0x63fb203ed400_0 {0 0 0};
    %jmp T_0.0;
T_0.1 ;
    %pop/vec4 1;
    %vpi_call/w 3 13 "$display", "\012=== Test Case 2: (200, 100) ===" {0 0 0};
    %pushi/vec4 5, 0, 32;
T_0.2 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_0.3, 5;
    %jmp/1 T_0.3, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %vpi_func 3 15 "$urandom_range" 32, 32'sb00000000000000000000000011001000, 32'sb00000000000000000000000001100100 {0 0 0};
    %pad/u 8;
    %store/vec4 v0x63fb203ed400_0, 0, 8;
    %vpi_call/w 3 16 "$display", "Result: %0d", v0x63fb203ed400_0 {0 0 0};
    %jmp T_0.2;
T_0.3 ;
    %pop/vec4 1;
    %vpi_call/w 3 19 "$display", "\012=== Test Case 3: (-20, 100) with unsigned variable ===" {0 0 0};
    %pushi/vec4 10, 0, 32;
T_0.4 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_0.5, 5;
    %jmp/1 T_0.5, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %vpi_func 3 21 "$urandom_range" 32, 32'sb11111111111111111111111111101100, 32'sb00000000000000000000000001100100 {0 0 0};
    %pad/u 8;
    %store/vec4 v0x63fb203ed400_0, 0, 8;
    %vpi_call/w 3 22 "$display", "Result (unsigned): %0d", v0x63fb203ed400_0 {0 0 0};
    %jmp T_0.4;
T_0.5 ;
    %pop/vec4 1;
    %vpi_call/w 3 25 "$display", "\012=== Test Case 3: (-20, 100) with SIGNED variable ===" {0 0 0};
    %pushi/vec4 10, 0, 32;
T_0.6 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_0.7, 5;
    %jmp/1 T_0.7, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %vpi_func 3 27 "$urandom_range" 32, 32'sb00000000000000000000000000000000, 32'sb00000000000000000000000001100100 {0 0 0};
    %cast2;
    %store/vec4 v0x63fb2039d7d0_0, 0, 32;
    %vpi_call/w 3 28 "$display", "Result (signed): %0d", v0x63fb2039d7d0_0 {0 0 0};
    %jmp T_0.6;
T_0.7 ;
    %pop/vec4 1;
    %vpi_call/w 3 31 "$display", "\012=== Showing the conversion explicitly ===" {0 0 0};
    %pushi/vec4 5, 0, 32;
T_0.8 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_0.9, 5;
    %jmp/1 T_0.9, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %vpi_func 3 33 "$urandom_range" 32, 32'sb11111111111111111111111111101100, 32'sb00000000000000000000000001100100 {0 0 0};
    %cast2;
    %store/vec4 v0x63fb2039d7d0_0, 0, 32;
    %load/vec4 v0x63fb2039d7d0_0;
    %pad/s 8;
    %store/vec4 v0x63fb203ed400_0, 0, 8;
    %vpi_call/w 3 35 "$display", "Signed: %0d \342\206\222 Unsigned (8-bit): %0d", v0x63fb2039d7d0_0, v0x63fb203ed400_0 {0 0 0};
    %jmp T_0.8;
T_0.9 ;
    %pop/vec4 1;
    %vpi_call/w 3 39 "$finish" {0 0 0};
    %end;
    .thread T_0;
